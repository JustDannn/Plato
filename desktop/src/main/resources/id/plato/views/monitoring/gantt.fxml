<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="id.plato.monitoring.GanttController" styleClass="page">
    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label fx:id="title" text="Gantt Chart" styleClass="h1"/>
        <Region HBox.hgrow="ALWAYS"/>
        <ComboBox fx:id="classBox" prefWidth="300"/>
    </HBox>
    <VBox fx:id="body" styleClass="card"/>
</VBox>
