<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="id.plato.user.SettingsController" styleClass="page">
    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label fx:id="title" text="Pengaturan" styleClass="h1"/>
        <Region HBox.hgrow="ALWAYS"/>

    </HBox>
    <HBox spacing="20">
        <VBox styleClass="card" HBox.hgrow="ALWAYS" prefWidth="100">
            <Label text="Profil" styleClass="h2"/>
            <Label fx:id="roleLine" styleClass="muted"/>
            <VBox spacing="6"><Label text="Nama" styleClass="form-label"/><TextField fx:id="nameField"/></VBox>
            <VBox spacing="6"><Label text="Email" styleClass="form-label"/><TextField fx:id="emailField"/></VBox>
            <Label fx:id="profileMessage" wrapText="true"/>
            <Button text="Simpan Profil" styleClass="btn-primary" onAction="#saveProfile"/>
        </VBox>
        <VBox styleClass="card" HBox.hgrow="ALWAYS" prefWidth="100">
            <Label text="Ganti Password" styleClass="h2"/>
            <VBox spacing="6"><Label text="Password saat ini" styleClass="form-label"/><PasswordField fx:id="currentPassword"/></VBox>
            <VBox spacing="6"><Label text="Password baru (minimal 8 karakter)" styleClass="form-label"/><PasswordField fx:id="newPassword"/></VBox>
            <Label fx:id="passwordMessage" wrapText="true"/>
            <Button text="Ganti Password" styleClass="btn-primary" onAction="#savePassword"/>
        </VBox>
    </HBox>
</VBox>
