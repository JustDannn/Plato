# Salin menjadi .env lalu ubah jika perlu:  cp .env.example .env
# Semua nilai di bawah adalah nilai untuk pengembangan lokal saja.

POSTGRES_DB=plato
POSTGRES_USER=plato
POSTGRES_PASSWORD=plato_dev_password

# Port di komputer kamu. Ganti jika bentrok dengan aplikasi lain.
API_PORT=8080
DB_PORT=5433

JWT_SECRET=plato_dev_secret_change_me_0123456789

# true = isi akun dan data contoh saat database masih kosong.
SEED_DEMO_DATA=true
